# nous-frontend — copy to .env.local. Anything in NEXT_PUBLIC_* is public — see
# CLAUDE.md hard rule #2. No API keys belong in this repo, ever.

NEXT_PUBLIC_API_URL=http://localhost:8000

# The backend has no password-reset endpoints yet. Set this to preview the three
# reset screens: the mock reset code is "123456". Login is never mocked — it
# always calls the backend. Leave unset to use the real (missing) endpoints.
# NEXT_PUBLIC_MOCK_PASSWORD_RESET=true
